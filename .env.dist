PHP_VERSION=7.1
ENABLE_METRICS=true

ENV=production
APP_DEBUG=false
APP_LOG=errorlog
LOG_LEVEL=debug
APP_ENDPOINT=https://invoice-as-a-service.cleverapps.io
APP_KEY=whatever

# Default number format, an example of 1234.56 ("1.234,56", "1 234,56", "1234.56"...). The `number_format` request field wins.
INVOICE_NUMBER_FORMAT=1,234.56

# SMTP used by the `email` option (example: Brevo, https://app.brevo.com/settings/keys/smtp)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=billing@example.com
MAIL_FROM_NAME=Invoice
